{% style %}
  #shopify-section-{{ section.id }} .listicle-banner {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background-color: {{ section.settings.background_color }};
    width: 100%;
    display: flex;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .listicle-banner__inner {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #shopify-section-{{ section.id }} .listicle-banner__inner > * {
    max-width: {{ section.settings.max_width_desktop }}%;
  }
  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .listicle-banner__inner > * {
      max-width: 100%;
    }
  }
  #shopify-section-{{ section.id }} .page-width {
    max-width: var(--page-width, 1200px);
    margin: 0 auto;
    padding: 0 20px;
  }
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .page-width {
      padding: 0 50px;
    }
  }
{% endstyle %}
<div class="listicle-banner">
  <div class="listicle-banner__inner page-width">
    {% content_for 'blocks' %}
  </div>
</div>
{% schema %}
{
  "name": "Listicle banner",
  "blocks": [
    {
      "type": "atlas_la_text"
    },
    {
      "type": "atlas_la_heading"
    },
    {
      "type": "atlas_la_trust_stars"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FAF7FA"
    },
    {
      "type": "range",
      "id": "max_width_desktop",
      "label": "Desktop content max width",
      "min": 30,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 56 
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Listicle banner"
    }
  ]
}
{% endschema %}