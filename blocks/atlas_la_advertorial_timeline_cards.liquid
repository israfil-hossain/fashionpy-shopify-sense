{% style %}
  .block-{{ block.id }} {
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.gap_between_cards_mobile }}px;
    list-style: none;
    padding-left: 0;
    margin:0;
  }
  .block-{{ block.id }} .advertorial-timeline-cards__item {
    display: flex;
    gap: {{ block.settings.gap_between_image_and_content_mobile }}px;
  }
  .block-{{ block.id }} .advertorial-timeline-cards__item-image {
    width: {{ block.settings.image_width }}px;
    height: {{ block.settings.image_height }}px;
    object-fit: cover;
    border-radius: {{ block.settings.image_border_radius }}px;
  }
  @media screen and (max-width: 1024px) {
    .block-{{ block.id }} .advertorial-timeline-cards__item-image {
      width: {{ block.settings.image_width_mobile }}px;
      height: {{ block.settings.image_height_mobile }}px;
    }
  }
  .block-{{ block.id }} .advertorial-timeline-cards__item-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 22px;
  }
  .block-{{ block.id }} .advertorial-timeline-cards__item-badge {
    display: flex;
    font-size: {{ block.settings.badge_font_size_mobile }}px;
    color: {{ block.settings.badge_color_text }};
    line-height: calc(100% + 12px);
    background: {{ block.settings.badge_background_color }};
    border-radius: {{ block.settings.badge_corner_radius }}px;
    width: fit-content;
    position: relative;
    padding-inline: {{ block.settings.badge_padding_inline }}px;
  }
  .block-{{ block.id }} .advertorial-timeline-cards__item-badge p {
    margin: 0;
  }
  .block-{{ block.id }} .advertorial-timeline-cards__indicator {
    position: absolute;
    top: 50%;
    transform: translate(-50%, -50%);
    left: -{{block.settings.gap_between_image_and_content_mobile}}px;
    width: {{ block.settings.indicator_size }}px;
    height: {{ block.settings.indicator_size }}px;
    background: {{ block.settings.indicator_background_color }};
    border-radius: 50%;
    border: {{ block.settings.indicator_border_width }}px solid {{ block.settings.indicator_border_color }};
    z-index: 1;
  }
   .block-{{ block.id }} .advertorial-timeline-cards__item-text {
        font-size: {{ block.settings.text_font_size_mobile }}px;
        color: {{ block.settings.text_color }};
        line-height: calc(100% + 14px);
   }
   .block-{{ block.id }} .advertorial-timeline-cards__item-text p {
    margin: 0;
   }
  @media screen and (max-width: 1024px) {
    .block-{{ block.id }} {
      padding-top: {{ block.settings.padding_top_mobile }}px;
      padding-bottom: {{ block.settings.padding_bottom_mobile }}px;
    }
  }
  @media screen and (min-width: 1025px) {
    .block-{{ block.id }} {
      gap: {{ block.settings.gap_between_cards }}px;
    }
    .block-{{ block.id }} .advertorial-timeline-cards__item {
      gap: {{ block.settings.gap_between_image_and_content }}px;
    }
    .block-{{ block.id }} .advertorial-timeline-cards__indicator {
      left: -{{block.settings.gap_between_image_and_content}}px;
    }
    .block-{{ block.id }} .advertorial-timeline-cards__item-badge {
      font-size: {{ block.settings.badge_font_size }}px;
    }
    .block-{{ block.id }} .advertorial-timeline-cards__item-text {
      font-size: {{ block.settings.text_font_size }}px;
    }
  }

{% endstyle %}
<ul class="advertorial-timeline-cards block-{{ block.id }}" {{ block.shopify_attributes }}>
    {% if block.settings.image_1 != blank %}
        <li class="advertorial-timeline-cards__item">
            <img class="advertorial-timeline-cards__item-image" src="{{ block.settings.image_1 | image_url: width: 500 }}" width="500" height="500" alt="{{ block.settings.image_1.alt }}">
            <div class="advertorial-timeline-cards__item-content">
                <div class="advertorial-timeline-cards__item-badge">
                    <div class="advertorial-timeline-cards__item-badge-text">{{ block.settings.badge_text_1 }}</div>
                    <div class="advertorial-timeline-cards__indicator"></div>
                </div>
                <div class="advertorial-timeline-cards__item-text">{{ block.settings.text_1 }}</div>
            </div>
        </li>
    {% endif %}
    {% if block.settings.image_2 != blank %}
        <li class="advertorial-timeline-cards__item">
            <img class="advertorial-timeline-cards__item-image" src="{{ block.settings.image_2 | image_url: width: 500 }}" width="500" height="500" alt="{{ block.settings.image_2.alt }}">
            <div class="advertorial-timeline-cards__item-content">
                <div class="advertorial-timeline-cards__item-badge">
                    <div class="advertorial-timeline-cards__item-badge-text">{{ block.settings.badge_text_2 }}</div>
                    <div class="advertorial-timeline-cards__indicator"></div>
                </div>
                <div class="advertorial-timeline-cards__item-text">{{ block.settings.text_2 }}</div>
            </div>
        </li>
    {% endif %}
    {% if block.settings.image_3 != blank %}
        <li class="advertorial-timeline-cards__item">
            <img class="advertorial-timeline-cards__item-image" src="{{ block.settings.image_3 | image_url: width: 500 }}" width="500" height="500" alt="{{ block.settings.image_3.alt }}">
            <div class="advertorial-timeline-cards__item-content">
                <div class="advertorial-timeline-cards__item-badge">
                    <div class="advertorial-timeline-cards__item-badge-text">{{ block.settings.badge_text_3 }}</div>
                    <div class="advertorial-timeline-cards__indicator"></div>
                </div>
                <div class="advertorial-timeline-cards__item-text">{{ block.settings.text_3 }}</div>
            </div>
        </li>
    {% endif %}
</ul>
