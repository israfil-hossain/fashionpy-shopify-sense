{% style %}
 .block-{{ block.id }} {
    padding-left: {{ block.settings.padding_left }}px;
    padding-right: {{ block.settings.padding_right }}px;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
  }
  .block-{{ block.id }} .trust-stars__inner {
    display: flex;
    padding: {{ block.settings.vertical_spacing }}px {{ block.settings.horizontal_spacing }}px;
    justify-content: center;
    align-items: center;
    
    /* Background */
    {% if block.settings.enable_background %}
      {% if block.settings.background_color_use_gradient and block.settings.background_color_gradient != blank %}
        background: {{ block.settings.background_color_gradient }};
      {% elsif block.settings.background_color != blank %}
        background-color: {{ block.settings.background_color }};
      {% endif %}
    {% endif %}
    
    border-radius: {{ block.settings.border_radius }}px;
    
    /* Box Shadow */
    {% if block.settings.enable_box_shadow %}
      box-shadow: {{ block.settings.shadow_x_offset }}px {{ block.settings.shadow_y_offset }}px {{ block.settings.shadow_blur }}px rgba({{ block.settings.shadow_color.red }}, {{ block.settings.shadow_color.green }}, {{ block.settings.shadow_color.blue }}, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
    {% else %}
      box-shadow: none;
    {% endif %}
  }
  .block-{{ block.id }} .trust-stars__stars {
    display: flex;
    gap: {{ block.settings.star_gap }}px;
    align-items: center;
  }
  .block-{{ block.id }} .trust-stars__stars svg {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
  }
  @media (max-width: 768px) {
    .block-{{ block.id }} {
      padding-left: {{ block.settings.padding_left_mobile }}px;
      padding-right: {{ block.settings.padding_right_mobile }}px;
      padding-top: {{ block.settings.padding_top_mobile }}px;
      padding-bottom: {{ block.settings.padding_bottom_mobile }}px;
    }
  }
{% endstyle %}
<div class="trust-stars block-{{ block.id }}" {{ block.shopify_attributes }}>
  <div class="trust-stars__inner">
    <div class="trust-stars__stars">
      {% for i in (1..block.settings.num_stars) %}
        <svg width="9" height="9" viewBox="0 0 9 9" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3.88954 0.41445C4.06954 -0.13815 4.85134 -0.13815 5.03074 0.41445L5.67274 2.38965C5.71196 2.50994 5.78821 2.61476 5.89058 2.68911C5.99296 2.76347 6.11621 2.80356 6.24274 2.80365H8.31994C8.90134 2.80365 9.14254 3.54765 8.67274 3.88965L6.99274 5.11005C6.89016 5.18447 6.81378 5.28946 6.77454 5.40996C6.73531 5.53047 6.73524 5.6603 6.77434 5.78085L7.41634 7.75605C7.59634 8.30865 6.96334 8.76885 6.49234 8.42685L4.81234 7.20645C4.70986 7.13205 4.58648 7.09198 4.45984 7.09198C4.33321 7.09198 4.20982 7.13205 4.10734 7.20645L2.42734 8.42685C1.95694 8.76885 1.32454 8.30865 1.50394 7.75605L2.14594 5.78085C2.18505 5.6603 2.18498 5.53047 2.14574 5.40996C2.10651 5.28946 2.03012 5.18447 1.92754 5.11005L0.248141 3.89025C-0.221659 3.54825 0.0201408 2.80425 0.600941 2.80425H2.67754C2.80417 2.80428 2.92756 2.76425 3.03006 2.68989C3.13255 2.61553 3.20889 2.51064 3.24814 2.39025L3.89014 0.41505L3.88954 0.41445Z" fill="{{ block.settings.star_color }}"/>
        </svg>    
      {% endfor %}
    </div>
    {% content_for 'blocks' %}
  </div>
</div>
{% schema %}
{
  "name": "Trust stars",
  "tag": null,
  "blocks": [
    {
      "type": "atlas_la_text"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Stars"
    },
    {
      "type": "range",
      "id": "num_stars",
      "label": "Number of stars",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#22C55E"
    },
    {
      "type": "range",
      "id": "star_size",
      "label": "Star size",
      "min": 6,
      "max": 50,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "star_gap",
      "label": "Star gap",
      "min": 0,
      "max": 15,
      "step": 1,
      "default": 7
    },
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Border radius",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 200
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "checkbox",
      "id": "enable_background",
      "label": "Enable Background",
      "default": false
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff",
      "visible_if": "{{ block.settings.enable_background and block.settings.background_color_use_gradient == false }}"
    },
    {
      "type": "checkbox",
      "id": "background_color_use_gradient",
      "label": "Use gradient background",
      "default": false,
      "visible_if": "{{ block.settings.enable_background }}"
    },
    {
      "type": "color_background",
      "id": "background_color_gradient",
      "label": "Background gradient",
      "visible_if": "{{ block.settings.enable_background and block.settings.background_color_use_gradient }}",
      "default": "linear-gradient(180deg, rgba(251, 51, 166, 1), rgba(127, 72, 176, 1) 50%, rgba(48, 145, 211, 1) 100%)"
    },
    {
      "type": "header",
      "content": "Box Shadow"
    },
    {
      "type": "checkbox",
      "id": "enable_box_shadow",
      "label": "Enable Box Shadow",
      "default": false
    },
    {
      "type": "range",
      "id": "shadow_x_offset",
      "min": -50,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Shadow X Offset",
      "default": 0,
      "visible_if": "{{ block.settings.enable_box_shadow }}"
    },
    {
      "type": "range",
      "id": "shadow_y_offset",
      "min": -50,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Shadow Y Offset",
      "default": 10,
      "visible_if": "{{ block.settings.enable_box_shadow }}"
    },
    {
      "type": "range",
      "id": "shadow_blur",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Shadow Blur",
      "default": 20,
      "visible_if": "{{ block.settings.enable_box_shadow }}"
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Shadow Color",
      "default": "#000000",
      "visible_if": "{{ block.settings.enable_box_shadow }}"
    },
    {
      "type": "range",
      "id": "shadow_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Shadow Opacity",
      "default": 20,
      "visible_if": "{{ block.settings.enable_box_shadow }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "vertical_spacing",
      "label": "Vertical spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 6
    },
    {
      "type": "range",
      "id": "horizontal_spacing",
      "label": "Horizontal spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:blocks.text.settings.padding_top.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:blocks.text.settings.padding_bottom.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Desktop left padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Desktop right padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:blocks.text.settings.padding_top_mobile.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:blocks.text.settings.padding_bottom_mobile.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_left_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile left padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_right_mobile",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile right padding",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Trust stars"
    }
  ]
}
{% endschema %}