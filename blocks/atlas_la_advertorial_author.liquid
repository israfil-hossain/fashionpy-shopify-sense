{% style %}
  .block-{{ block.id }} {
    padding-top: {{ block.settings.padding_top_mobile }}px;
    padding-bottom: {{ block.settings.padding_bottom_mobile }}px;
    display: flex;
    width: 100%;
    align-items: center;
    gap: 11px;
  }
  .block-{{ block.id }} img{
    width: {{ block.settings.author_image_size_mobile }}px; 
    height: {{ block.settings.author_image_size_mobile }}px;
    border-radius: 50%;
    overflow: hidden;
    object-fit: cover;
  }
  .block-{{ block.id }} .advertorial-author__content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .block-{{ block.id }} .advertorial-author__name {
    font-size: {{ block.settings.author_name_font_size_mobile }}px;
    line-height: 100%;
    color: {{ block.settings.author_name_color }};
  }
  .block-{{ block.id }} .advertorial-author__title {
    font-size: {{ block.settings.author_title_font_size_mobile }}px;
    line-height: 100%;
    color: {{ block.settings.author_title_color }};
  }
  .block-{{ block.id }} .advertorial-author__title strong, .block-{{ block.id }} .advertorial-author__name strong {
    font-weight: 700;
  }
  @media (min-width: 750px) {
    .block-{{ block.id }} {
      padding-top: {{ block.settings.padding_top }}px;
      padding-bottom: {{ block.settings.padding_bottom }}px;
    }
    .block-{{ block.id }} img {
      width: {{ block.settings.author_image_size }}px; 
      height: {{ block.settings.author_image_size }}px;
    }
    .block-{{ block.id }} .advertorial-author__name {
      font-size: {{ block.settings.author_name_font_size }}px;
    }
    .block-{{ block.id }} .advertorial-author__title {
      font-size: {{ block.settings.author_title_font_size }}px;
    }
  }
{% endstyle %}
<div class="advertorial-author block-{{ block.id }}" {{ block.shopify_attributes }}>
    {% if block.settings.author_image != blank %}
        <img src="{{ block.settings.author_image | image_url: width: 500 }}" alt="{{ block.settings.author_name }}" width="500" height="500">
    {% endif %}
  <div class="advertorial-author__content">
    {% if block.settings.author_name != blank %}
        <div class="advertorial-author__name">
        {{ block.settings.author_name }}
        </div>
    {% endif %}
    {% if block.settings.author_title != blank %}
      <div class="advertorial-author__title">
        {{ block.settings.author_title }}
      </div>
    {% endif %}
  </div>
</div>
{% schema %}
{
  "name": "Advertorial author",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "author_image",
      "label": "Author image"
    },
    {
      "type": "inline_richtext",
      "id": "author_name",
      "label": "Author name",
      "default": "John Doe"
    },
    {
      "type": "inline_richtext",
      "id": "author_title",
      "label": "Author title",
      "default": "CEO at Company"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "range",
      "id": "author_image_size",
      "label": "Desktop image size",
      "min": 30,
      "max": 130,
      "step": 1,
      "unit": "px",
      "default": 39
    },
    {
      "type": "range",
      "id": "author_image_size_mobile",
      "label": "Mobile image size",
      "min": 30,
      "max": 130,
      "step": 1,
      "unit": "px",
      "default": 39
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "author_name_font_size",
      "label": "Desktop name font size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "author_name_font_size_mobile",
      "label": "Mobile name font size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "author_title_font_size",
      "label": "Desktop title font size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "author_title_font_size_mobile",
      "label": "Mobile title font size",
      "min": 12,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "author_name_color",
      "label": "Name color",
      "default": "#1f1f1f"
    },
    {
      "type": "color",
      "id": "author_title_color",
      "label": "Title color",
      "default": "#1f1f1f"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 5
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Advertorial author"
    }
  ]
}
{% endschema %}