{% style %}
  .block-{{ block.id }} {
    padding-top: {{ block.settings.padding_top_mobile }}px;
    padding-bottom: {{ block.settings.padding_bottom_mobile }}px;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.gap_between_cards_mobile }}px;
    list-style: none;
    padding-left: 0;
    margin:0;
  }
  .block-{{ block.id }} .advertorial-review-cards__item {
    width: 100%;
    background: {{ block.settings.card_background_color }};
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    display: flex;
    gap: {{ block.settings.gap_between_image_and_content_mobile }}px;
    padding: {{ block.settings.card_padding_desktop }}px;
  }
  .block-{{ block.id }} .advertorial-review-cards__item-image {
    width: 100%;
    object-fit: cover;
    {% if block.settings.image_height_mobile == 'adapt' %}
      height: auto;
    {% elsif block.settings.image_height_mobile == 'small' %}
      height: 300px;
    {% elsif block.settings.image_height_mobile == 'medium' %}
      height: 400px;
    {% elsif block.settings.image_height_mobile == 'large' %}
      height: 500px;
    {% endif %}
  }
  .block-{{ block.id }} .advertorial-review-cards__item-content {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap_mobile }}px;
  }
  .block-{{ block.id }} .advertorial-reviews-cards__author-content {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.author_content_gap_mobile }}px;
  }
  .block-{{ block.id }} .advertorial-review-cards__item-author {
    display: flex;
    gap: {{ block.settings.author_gap_mobile }}px;
  }
  .block-{{ block.id }} .advertorial-review-cards__item-author-image {
    width: {{ block.settings.author_image_size_mobile }}px;
    height: {{ block.settings.author_image_size_mobile }}px;
    border-radius: 50%;
    object-fit: cover;
  }
  .block-{{ block.id }} .advertorial-review-cards__item-author-name {
    font-size: {{ block.settings.author_name_font_size_mobile }}px;
    line-height: 100%;
    color: {{ block.settings.author_name_color }};
  }
  .block-{{ block.id }} .advertorial-review-cards__item-text {
    font-size: {{ block.settings.text_font_size_mobile }}px;
    line-height: calc(100% + 12px);
    color: {{ block.settings.text_color }};
  }
  .block-{{ block.id }} .advertorial-review-cards__item-text p {
    margin: 0;
  }
  .block-{{ block.id }} .advertorial-reviews-cards__author-name-and-verified {
    display: flex;
    gap: {{ block.settings.name_and_verified_gap_mobile }}px;
    align-items: center;
  }
  .block-{{ block.id }} .advertorial-reviews-cards__author-verified-icon {
    width: {{ block.settings.verified_icon_size_mobile }}px;
    height: {{ block.settings.verified_icon_size_mobile }}px;
  }
  .block-{{ block.id }} .advertorial-reviews-cards__author-stars {
    display: flex;
    gap: {{ block.settings.stars_gap_mobile }}px;
  }
  .block-{{ block.id }} .advertorial-reviews-cards__author-stars-star {
    width: {{ block.settings.star_size_mobile }}px;
    height: {{ block.settings.star_size_mobile }}px;
  }
  .block-{{  block.id  }} .advertorial-reviews-cards__author-name {
    font-size: {{ block.settings.author_name_display_font_size_mobile }}px;
    line-height: calc(100% + 11px);
    color: {{ block.settings.author_name_display_color }};
  }
  .block-{{  block.id  }} .advertorial-reviews-cards__author-name strong {
    font-weight: 700;
  }
  .block-{{  block.id  }} .advertorial-reviews-cards__author-location {
    font-size: {{ block.settings.author_location_font_size_mobile }}px;
    line-height: calc(100% + 13px);
    color: {{ block.settings.author_location_color }};
  }

  .block-{{ block.id }} p {
    margin: 0;
  }
  @media (max-width: 768px) {
    .block-{{ block.id }} .advertorial-review-cards__item { 
      flex-direction: column-reverse;
      padding: {{ block.settings.card_padding_mobile }}px;
    }
  }
  @media screen and (min-width: 769px) {
    .block-{{ block.id }} {
      padding-top: {{ block.settings.padding_top }}px;
      padding-bottom: {{ block.settings.padding_bottom }}px;
      gap: {{ block.settings.gap_between_cards }}px;
    }
    .block-{{ block.id }} .advertorial-review-cards__item {
      gap: {{ block.settings.gap_between_image_and_content }}px;
    }
    .block-{{ block.id }} .advertorial-review-cards__item-image {
      width: {{ block.settings.image_width }}px;
      height: {{ block.settings.image_height }}px;
    }
    .block-{{ block.id }} .advertorial-review-cards__item-content {
      gap: {{ block.settings.content_gap }}px;
    }
    .block-{{ block.id }} .advertorial-reviews-cards__author-content {
      gap: {{ block.settings.author_content_gap }}px;
    }
    .block-{{ block.id }} .advertorial-review-cards__item-author {
      gap: {{ block.settings.author_gap }}px;
    }
    .block-{{ block.id }} .advertorial-review-cards__item-author-image {
      width: {{ block.settings.author_image_size }}px;
      height: {{ block.settings.author_image_size }}px;
    }
    .block-{{ block.id }} .advertorial-review-cards__item-author-name {
      font-size: {{ block.settings.author_name_font_size }}px;
    }
    .block-{{ block.id }} .advertorial-review-cards__item-text {
      font-size: {{ block.settings.text_font_size }}px;
    }
    .block-{{ block.id }} .advertorial-reviews-cards__author-name-and-verified {
      gap: {{ block.settings.name_and_verified_gap }}px;
    }
    .block-{{ block.id }} .advertorial-reviews-cards__author-verified-icon {
      width: {{ block.settings.verified_icon_size }}px;
      height: {{ block.settings.verified_icon_size }}px;
    }
    .block-{{ block.id }} .advertorial-reviews-cards__author-stars {
      gap: {{ block.settings.stars_gap }}px;
    }
    .block-{{ block.id }} .advertorial-reviews-cards__author-stars-star {
      width: {{ block.settings.star_size }}px;
      height: {{ block.settings.star_size }}px;
    }
    .block-{{  block.id  }} .advertorial-reviews-cards__author-name {
      font-size: {{ block.settings.author_name_display_font_size }}px;
    }
    .block-{{  block.id  }} .advertorial-reviews-cards__author-location {
      font-size: {{ block.settings.author_location_font_size }}px;
    }
  }
