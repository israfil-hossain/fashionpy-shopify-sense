{% if request.visual_preview_mode %}
  {% assign block_id_variable = 'layout-block-id' %}
{% else %}
  {% assign block_id_variable = block.id %}
{% endif %}

{% style %}
  .layout-block-{{ block_id_variable }} {
    width: 100%;
    display: flex;
    flex-direction: {{ block.settings.flex_direction }};
    gap: {{ block.settings.gap }}px;
    {% if block.settings.flex_direction == 'row' %}
      align-items: {{ block.settings.vertical_alignment }};
      justify-content: {{ block.settings.horizontal_alignment }};
    {% else %}
      align-items: {{ block.settings.horizontal_alignment }};
      justify-content: {{ block.settings.vertical_alignment }};
    {% endif %}
    
    /* Padding - Inner Spacing */
    padding-top: {{ block.settings.padding_top_desktop }}px;
    padding-bottom: {{ block.settings.padding_bottom_desktop }}px;
    padding-left: {{ block.settings.padding_left_desktop }}px;
    padding-right: {{ block.settings.padding_right_desktop }}px;
    
    /* Margin - Outer Spacing */
    margin-top: {{ block.settings.margin_top_desktop }}px;
    margin-bottom: {{ block.settings.margin_bottom_desktop }}px;
    margin-left: {{ block.settings.margin_left_desktop }}px;
    margin-right: {{ block.settings.margin_right_desktop }}px;
    
    /* Border Radius */
    border-radius: {{ block.settings.border_radius }}px;
    
    /* Border */
    {% if block.settings.enable_border %}
      border-width: {{ block.settings.border_width }}px;
      border-style: {{ block.settings.border_style }};
      {% if block.settings.border_color != blank %}
        border-color: rgba({{ block.settings.border_color.red }}, {{ block.settings.border_color.green }}, {{ block.settings.border_color.blue }}, {{ block.settings.border_opacity | divided_by: 100.0 }});
      {% endif %}
    {% else %}
      border: none;
    {% endif %}
    
    /* Background */
    {% if block.settings.enable_background %}
      {% if block.settings.background_use_gradient and block.settings.background_gradient_color != blank %}
        background: {{ block.settings.background_gradient_color }};
      {% elsif block.settings.background_color != blank %}
        background-color: rgba({{ block.settings.background_color.red }}, {{ block.settings.background_color.green }}, {{ block.settings.background_color.blue }}, {{ block.settings.background_opacity | divided_by: 100.0 }});
      {% endif %}
    {% endif %}
    
    /* Box Shadow */
    {% if block.settings.enable_box_shadow %}
      box-shadow: {{ block.settings.shadow_x_offset }}px {{ block.settings.shadow_y_offset }}px {{ block.settings.shadow_blur }}px rgba({{ block.settings.shadow_color.red }}, {{ block.settings.shadow_color.green }}, {{ block.settings.shadow_color.blue }}, {{ block.settings.shadow_opacity | divided_by: 100.0 }});
    {% else %}
      box-shadow: none;
    {% endif %}
    flex: {{ block.settings.flex_grow }};
  }
  
  @media screen and (max-width: 750px) {
    .layout-block-{{ block_id_variable }} {
      flex-direction: {{ block.settings.flex_direction_mobile }};
      gap: {{ block.settings.gap_mobile }}px;
      {% if block.settings.flex_direction_mobile == 'row' %}
        align-items: {{ block.settings.vertical_alignment_mobile }};
        justify-content: {{ block.settings.horizontal_alignment_mobile }};
      {% else %}
        align-items: {{ block.settings.horizontal_alignment_mobile }};
        justify-content: {{ block.settings.vertical_alignment_mobile }};
      {% endif %}
      
      /* Padding - Inner Spacing Mobile */
      padding-top: {{ block.settings.padding_top_mobile }}px;
      padding-bottom: {{ block.settings.padding_bottom_mobile }}px;
      padding-left: {{ block.settings.padding_left_mobile }}px;
      padding-right: {{ block.settings.padding_right_mobile }}px;
      
      /* Margin - Outer Spacing Mobile */
      margin-top: {{ block.settings.margin_top_mobile }}px;
      margin-bottom: {{ block.settings.margin_bottom_mobile }}px;
      margin-left: {{ block.settings.margin_left_mobile }}px;
      margin-right: {{ block.settings.margin_right_mobile }}px;
      
      flex: {{ block.settings.flex_grow_mobile }};
    }
  }
  {% if block.settings.enable_backdrop %}
    .layout-block-{{ block_id_variable }} {
      position: relative;
      z-index: 1;
    }
    .layout-block-{{ block_id_variable }}::before {
      content: '';
      position: absolute;
      left: {{ block.settings.backdrop_left }}%;
      top: {{ block.settings.backdrop_top }}%;
      width: {{ block.settings.backdrop_width }}%;
      height: {{ block.settings.backdrop_height }}%;
      border-radius: {{ block.settings.backdrop_border_radius }}px;
      opacity: {{ block.settings.backdrop_opacity | divided_by: 100.0 }};
      filter: blur({{ block.settings.backdrop_blur }}px);
      z-index: -1;
      {% if block.settings.backdrop_use_gradient and block.settings.backdrop_gradient_color != blank %}
        background: {{ block.settings.backdrop_gradient_color }};
      {% elsif block.settings.backdrop_color != blank %}
        background-color: {{ block.settings.backdrop_color }};
      {% endif %}
    }
  {% endif %}
{% endstyle %}

<div class="layout-block layout-block-{{ block_id_variable }}" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

