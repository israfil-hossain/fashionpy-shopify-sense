<ul class="advertorial-list-icon-text block-{{ block.id }}" {{ block.shopify_attributes }}>
  {% if block.settings.text_1 != blank %}
    <li {% if block.settings.icon_1_have_background %}style="background: rgba({{ block.settings.icon_1_background_color.red }}, {{ block.settings.icon_1_background_color.green }}, {{ block.settings.icon_1_background_color.blue }}, {{ block.settings.icon_1_custom_background_opacity | divided_by: 100.0 }});"{% endif %}>
