{% style %}
.block-{{ block.id }} {
    gap: {{ block.settings.gap_between_items_mobile }}px;
    padding-top: {{ block.settings.padding_top_mobile }}px;
    padding-bottom: {{ block.settings.padding_bottom_mobile }}px;
    display: flex;
    flex-direction: column;
    list-style: none;
    padding-left: 0;
    margin: 0;
}
.block-{{ block.id }} > li {
  display: flex;
  align-items: center;
  {% if block.settings.icon_last %}
   flex-direction: row-reverse;
   justify-content: flex-end;
  {% endif %}
}
  .block-{{ block.id }} > li {
    gap: {{ block.settings.icon_text_gap_mobile }}px;
    padding: {{ block.settings.icon_text_vertical_padding_mobile }}px {{ block.settings.icon_text_horizontal_padding_mobile }}px;
    {% if block.settings.icon_text_have_background %}
      background: rgba({{ block.settings.icon_text_background_color.red }}, {{ block.settings.icon_text_background_color.green }}, {{ block.settings.icon_text_background_color.blue }}, {{ block.settings.icon_text_background_opacity | divided_by: 100.0 }});  
    {% endif %}
  }
  .block-{{ block.id }} .material-icon svg,
  .block-{{ block.id }}  img {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
  }
  .block-{{ block.id }}  img  {
      object-fit: contain;
  }
  .block-{{ block.id }} .advertorial-list-icon-text-text {
    font-size: {{ block.settings.font_size_mobile }}px;
    color: {{ block.settings.text_color }};
    line-height: 100%;
  }
  .block-{{ block.id }} .emoji-icon-1,
  .block-{{ block.id }} .emoji-icon-2,
  .block-{{ block.id }} .emoji-icon-3,
  .block-{{ block.id }} .emoji-icon-4,
  .block-{{ block.id }} .emoji-icon-5,
  .block-{{ block.id }} .emoji-icon-6 {
    font-size: {{ block.settings.icon_size_mobile }}px;
  }
  .block-{{ block.id }} .advertorial-list-icon-text-text strong {
    font-weight: 700;
    {% if block.settings.text_use_gradient %}
      background: {% if block.settings.text_gradient_color != blank %}{{ block.settings.text_gradient_color }}{% else %}var(--color-highlighted-color){% endif %};
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    {% else %}
      color: {{ block.settings.text_highlighted_color }};
    {% endif %}
  }
  {% if block.settings.icon_1_have_custom_text_color %}
    .block-{{ block.id }} > li:nth-child(1) .advertorial-list-icon-text-text {
      color: {{ block.settings.icon_1_custom_text_color }};
    }
    .block-{{ block.id }} > li:nth-child(1) .advertorial-list-icon-text-text strong {
      {% if block.settings.icon_1_have_custom_text_highlighted_gradient %}
        background: {{ block.settings.icon_1_custom_text_highlighted_gradient_color }};
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      {% else %}
        color: {{ block.settings.icon_1_custom_text_highlighted_color }};
      {% endif %}
    }
  {% endif %}
  {% if block.settings.icon_2_have_custom_text_color %}
    .block-{{ block.id }} > li:nth-child(2) .advertorial-list-icon-text-text {
      color: {{ block.settings.icon_2_custom_text_color }};
    }
    .block-{{ block.id }} > li:nth-child(2) .advertorial-list-icon-text-text strong {
      {% if block.settings.icon_2_have_custom_text_highlighted_gradient %}
